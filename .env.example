# Copy to .env and fill in. .env is gitignored and must never be committed.

# AMC vendor API key — sent as the X-AMC-Vendor-Key header to
# api.amctheatres.com. Third-party write-ups claim X-API-Key; that is wrong,
# and the spec refutes it explicitly.
AMC_API_KEY=

# TMDB API read access token
TMDB_API_KEY=

# Letterboxd account for the taste sync
LETTERBOXD_USERNAME=
